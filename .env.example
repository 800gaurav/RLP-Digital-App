# Web simulator/local browser
EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:3000/api

# Production/live backend
# EXPO_PUBLIC_API_URL=https://rlp.genzteck.com/api

# Physical Android device on same Wi-Fi:
# Replace 192.168.1.10 with your computer's IPv4 address from ipconfig.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# Public verification URL used by QR codes and exported ID cards
EXPO_PUBLIC_VERIFY_URL=https://rlpdigital.in/verify
# Production:
# EXPO_PUBLIC_VERIFY_URL=https://rlp.genzteck.com/api/verify
