{
  "expo": {
    "name": "RLP Digital",
    "slug": "rlp-digital",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rlpdigital",
    "userInterfaceStyle": "light",
    "icon": "./assets/rlp_splash.png",
    "splash": {
      "image": "./assets/rlp_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#006E2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rlp.digital"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/rlp_splash.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rlp.digital",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RLP Digital to access your photos for profile picture.",
          "cameraPermission": "Allow RLP Digital to use your camera for profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow RLP Digital to save media to your gallery.",
          "savePhotosPermission": "Allow RLP Digital to save photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFD400"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edb8e436-ff31-4a53-ab8e-fb8e8f80c1ba"
      }
    }
  }
}
